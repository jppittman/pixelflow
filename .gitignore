/target
/target.noindex
CoreTerm.app
.DS_Store
/vendor

.gemini*/
gha-creds-*.json
*.ppm
# Golden reference images are the one deliberate exception: checked into git
# so visual-regression tests have something to compare against.
!pixelflow-graphics/tests/golden/*.ppm
*.log
*.db
*.pyc
.code-index/

# Training artifacts (regenerated, large)
pixelflow-pipeline/data/*

# cargo-mutants scratch output
mutants.out/
mutants.out.old/

# Isolated git worktrees created for background agents. Transient harness
# state, not project content — and large enough (tens of MB) that a stray
# `git add -A` would sweep them into a commit.
.claude/worktrees/
# Per-agent build caches (one per parallel worktree; see docs/plans/2026-09-25-the-language-is-kernel.md).
/target.noindex-*/
